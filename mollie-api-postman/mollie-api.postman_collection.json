    {
      "name": "4. Error handling",
      "item": [
        {
          "name": "Invalid amount (expect 422)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v2/payments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v2",
                "payments"
              ]
            },
            "description": "Negative test: shows how the API reports validation errors.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": {\n    \"currency\": \"EUR\",\n    \"value\": \"abc\"\n  },\n  \"description\": \"Bad amount\",\n  \"redirectUrl\": \"https://example.org/thanks\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Mollie rejects invalid input with 422\", () => pm.response.to.have.status(422));",
                  "pm.test(\"Error body explains the problem\", () => pm.expect(pm.response.json().detail).to.be.a(\"string\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Missing API key (expect 401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v2/payments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v2",
                "payments"
              ]
            },
            "description": "Authorization is overridden with 'No Auth' on this request, so it should be rejected.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Request without a valid key is refused\", () => pm.expect([401,403]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5. Recurring (first payment, mandate, subscription)",
      "item": [
        {
          "name": "First payment (starts a mandate)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": {\n    \"currency\": \"EUR\",\n    \"value\": \"9.99\"\n  },\n  \"description\": \"First payment for mandate\",\n  \"redirectUrl\": \"https://example.org/thanks\",\n  \"customerId\": \"{{customerId}}\",\n  \"sequenceType\": \"first\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/v2/payments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v2",
                "payments"
              ]
            },
            "description": "Run 'Create customer' first (folder 3). Without `method`, the checkout offers only methods that can start a mandate. A card creates a card mandate; iDEAL, Bancontact and similar methods create a SEPA direct debit mandate, which only works if SEPA Direct Debit is also enabled on the profile. If the needed method is not enabled, Mollie returns 422 ('The payment method selected does not accept recurring payments')."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201 Created\", () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.test(\"Sequence type is first\", () => pm.expect(b.sequenceType).to.eql(\"first\"));",
                  "pm.collectionVariables.set(\"paymentId\", b.id);",
                  "pm.collectionVariables.set(\"checkoutUrl\", b._links.checkout.href);",
                  "console.log(\"Open this checkout and complete it as a test payment:\", b._links.checkout.href);"
                ]
              }
            }
          ]
        },
        {
          "name": "List mandates",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v2/customers/{{customerId}}/mandates",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v2",
                "customers",
                "{{customerId}}",
                "mandates"
              ]
            },
            "description": "A mandate is the customer's permission to charge them again later. It appears only after the first payment is completed."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const m = pm.response.json()._embedded.mandates;",
                  "const valid = m.find(x => x.status === \"valid\");",
                  "if (valid) { pm.collectionVariables.set(\"mandateId\", valid.id); }",
                  "pm.test(\"A valid mandate exists (complete the first payment first)\", () => pm.expect(valid, \"no valid mandate yet\").to.not.be.undefined);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create subscription",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": {\n    \"currency\": \"EUR\",\n    \"value\": \"5.00\"\n  },\n  \"interval\": \"1 month\",\n  \"times\": 3,\n  \"description\": \"Postman practice subscription\",\n  \"webhookUrl\": \"{{webhookUrl}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/v2/customers/{{customerId}}/subscriptions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v2",
                "customers",
                "{{customerId}}",
                "subscriptions"
              ]
            },
            "description": "Needs a valid mandate (see List mandates). `interval` is e.g. '1 month' or '2 weeks', `times` limits the number of charges. Test-mode subscriptions are canceled automatically after 10 payments."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// A subscription creates recurring charges, so it must never be sent twice by accident.",
                  "pm.request.headers.upsert({ key: \"Idempotency-Key\", value: pm.variables.replaceIn(\"{{$guid}}\") });"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201 Created\", () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.test(\"Subscription is active or pending\", () => pm.expect([\"active\", \"pending\"]).to.include(b.status));",
                  "pm.collectionVariables.set(\"subscriptionId\", b.id);",
                  "console.log(\"Next payment date:\", b.nextPaymentDate);"
                ]
              }
            }
          ]
        },
        {
          "name": "List subscription payments",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v2/customers/{{customerId}}/subscriptions/{{subscriptionId}}/payments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v2",
                "customers",
                "{{customerId}}",
                "subscriptions",
                "{{subscriptionId}}",
                "payments"
              ]
            },
            "description": "Empty until the first scheduled charge date. Payments created by a subscription have sequenceType recurring."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "console.log(\"Payments so far:\", (pm.response.json()._embedded?.payments || []).length);"
                ]
              }
            }
          ]
        },
        {
          "name": "Cancel subscription",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v2/customers/{{customerId}}/subscriptions/{{subscriptionId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v2",
                "customers",
                "{{customerId}}",
                "subscriptions",
                "{{subscriptionId}}"
              ]
            },
            "description": "Clean-up step. Cancels the subscription; the mandate and customer stay."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Subscription is canceled\", () => pm.expect(pm.response.json().status).to.eql(\"canceled\"));"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "paymentId",
      "value": ""
    },
    {
      "key": "checkoutUrl",
      "value": ""
    },
    {
      "key": "customerId",
      "value": ""
    },
    {
      "key": "amount",
      "value": "10.00"
    },
    {
      "key": "idempotencyKey",
      "value": ""
    },
    {
      "key": "idempotentPaymentId",
      "value": ""
    },
    {
      "key": "mandateId",
      "value": ""
    },
    {
      "key": "subscriptionId",
      "value": ""
    },
    {
      "key": "pollCount",
      "value": "0"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Safety guard: this collection may only talk to Mollie TEST mode.",
          "const key = pm.environment.get(\"apiKey\") || pm.collectionVariables.get(\"apiKey\");",
          "if (!key || !String(key).startsWith(\"test_\")) {",
          "  pm.execution.skipRequest();   // make sure the request is NOT sent (a thrown error alone is not enough in every runner)",
          "  throw new Error(\"Refusing to send: set apiKey in the 'Mollie test' environment to a key that starts with test_. This collection is for test mode only.\");",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Runs after every request in the collection.",
          "pm.test(\"Response is JSON\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"json\"));"
        ]
      }
    }
  ]
}